package templates

import "github.com/jakubsacha/signature-collector/i18n"

templ Layout(content templ.Component) {
	<!DOCTYPE html>
	<html lang={i18n.GetLanguage()}>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"/>
			<title>{i18n.T("AppTitle", nil)}</title>
			<link rel="manifest" href="/manifest.json"/>
			<meta name="theme-color" content="#F6F0E4"/>
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<link rel="icon" href="/static/icon.svg" type="image/svg+xml"/>
			<link rel="icon" href="/static/icon-192.png" sizes="192x192" type="image/png"/>
			<link rel="apple-touch-icon" href="/static/icon-192.png"/>
			<script src="https://unpkg.com/htmx.org@1.9.9"></script>
			<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
			<script src="https://cdn.tailwindcss.com"></script>
		</head>
		<body class="bg-[#F6F0E4] overscroll-none">
			@content
			<script>
				// Registering a service worker is what makes Chrome treat the app as
				// installable, which in turn lets the home-screen shortcut honour
				// "display": "fullscreen" from the manifest.
				if ('serviceWorker' in navigator) {
					window.addEventListener('load', () => {
						navigator.serviceWorker.register('/sw.js').catch((error) => {
							console.error('Service worker registration failed', error);
						});
					});
				}

				// The manifest only binds orientation for the installed app, so lock it
				// again at runtime to keep a running session upright. Locking is allowed
				// in fullscreen/standalone only; in a plain browser tab it rejects, and
				// there is nothing to enforce there, so the rejection is ignored.
				function lockPortrait() {
					try {
						const lock = screen.orientation && screen.orientation.lock;
						if (lock) {
							screen.orientation.lock('portrait-primary').catch(() => {});
						}
					} catch (error) {
						// Older browsers throw instead of rejecting.
					}
				}
				lockPortrait();
				// A relock is needed after the app is brought back to the foreground,
				// which drops the lock on some Android builds.
				document.addEventListener('visibilitychange', () => {
					if (!document.hidden) {
						lockPortrait();
					}
				});
			</script>
		</body>
	</html>
}
